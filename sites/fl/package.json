{
  "name": "@jstqb/site-fl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JSTQB Foundation Level の合格を目指す非公式の学習コンテンツです。",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:lint": "textlint --config ../../.textlintrc.json \"docs/**/*.md\"",
    "quiz:validate": "node ../../packages/shared/scripts/quiz-validate.mjs .",
    "check:bold": "find docs/lessons -maxdepth 2 -name index.md -print0 | xargs -0 -r node ../../.claude/hooks/check-bold.js",
    "check:style": "node ../../.claude/hooks/check-style.js docs/lessons",
    "pwa:icons": "pwa-assets-generator",
    "test:e2e": "node tests/run-all.mjs",
    "test:e2e:main": "node tests/quiz.e2e.mjs"
  },
  "dependencies": {
    "@jstqb/shared": "*"
  }
}
